<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>pcble2gamepad</vendor>
  <vendor_url>https://github.com/wozt/pcble2gamepad</vendor_url>
  <action id="io.github.wozt.pcble2gamepad.run-classic">
    <description>Start a pcble2gamepad Bluetooth controller session</description>
    <message>Authentication is required to control the Bluetooth adapter</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@PCBLE2GAMEPAD_RUNNER_PATH@</annotate>
  </action>
</policyconfig>
