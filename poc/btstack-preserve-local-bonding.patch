diff --git a/port/linux/btstack_config.h b/port/linux/btstack_config.h
index a547005..9318c8e 100644
--- a/port/linux/btstack_config.h
+++ b/port/linux/btstack_config.h
@@ -14,6 +14,12 @@
 #define HAVE_POSIX_FILE_IO
 #define HAVE_POSIX_TIME
 
+/*
+ * pcble2gamepad experiment: a Switch-initiated SSP exchange advertises
+ * No Bonding remotely, but a real controller must retain its local bond.
+ */
+#define PCBLE2GAMEPAD_PRESERVE_LOCAL_DEDICATED_BONDING
+
 // BTstack features that can be enabled
 #define ENABLE_ATT_DELAYED_RESPONSE
 #define ENABLE_AVRCP_COVER_ART
diff --git a/src/hci.c b/src/hci.c
index 5bf52b0..b1056f2 100644
--- a/src/hci.c
+++ b/src/hci.c
@@ -8153,7 +8153,17 @@ static bool hci_run_general_pending_commands(void){
                 // if we have received IO Cap Response, we're in responder role
                 bool remote_bonding = connection->io_cap_response_auth_req >= SSP_IO_AUTHREQ_MITM_PROTECTION_NOT_REQUIRED_DEDICATED_BONDING;
                 if (bonding && !remote_bonding){
+#ifdef PCBLE2GAMEPAD_PRESERVE_LOCAL_DEDICATED_BONDING
+                    /*
+                     * Keep the local controller bond when the host initiates
+                     * SSP with No Bonding. Do not set BONDING_DEDICATED here:
+                     * that flag also requests BTstack's dedicated-procedure
+                     * disconnect. Only the on-air AuthReq must be 0x02.
+                     */
+                    connection->io_cap_request_auth_req |= SSP_IO_AUTHREQ_MITM_PROTECTION_NOT_REQUIRED_DEDICATED_BONDING;
+#else
                     log_info("Remote not bonding, dropping local flag");
+#endif
                     bonding = false;
                 }
             }
